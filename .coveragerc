[run]
source = src
omit =
    */site-packages/*
    */dist-packages/*
    */tests/*
    */__pycache__/*
    */.pytest_cache/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError
    raise AssertionError
